# Copier ces lignes dans le .env à la RACINE du dépôt (C:\Users\Dell\TradingAgents\.env).
# Le .env est ignoré par git : les clés n'en sortent jamais.

# --- Telegram ---------------------------------------------------------------
# Token donné par @BotFather
TELEGRAM_BOT_TOKEN=
# Ton identifiant numérique Telegram (demande-le à @userinfobot). Le bot ignore tous les autres.
TELEGRAM_ALLOWED_USER_ID=
# Nombre maximum de nouvelles analyses par jour (les résultats en cache ne comptent pas)
MAX_ANALYSES_PER_DAY=5
# Fuseau qui définit « aujourd'hui » pour le cache et le quota
BOT_TIMEZONE=Europe/Paris

# --- LLM ----------------------------------------------------------------------
# Fournisseur : openai, anthropic, google, deepseek, openrouter, mistral, ollama…
TRADINGAGENTS_LLM_PROVIDER=openai
# Modèle rapide (les 3 analystes) et modèle profond (le synthétiseur)
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_DEEP_THINK_LLM=
# La clé du fournisseur choisi (une seule suffit)
OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=

# Optionnel : limiter les appels d'outils d'un analyste (défaut 20) pour réduire le coût
#TRADINGAGENTS_MAX_TOOL_ROUNDS=8
# Optionnel : FRED (macro) pour l'analyste News, clé gratuite
#FRED_API_KEY=
